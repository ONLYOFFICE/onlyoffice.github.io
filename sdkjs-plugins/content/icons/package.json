{
    "scripts": {
        "build": "rollup -c",
        "build:es5": "rollup -c --environment TARGET:es5",
        "build:modern": "rollup -c --environment TARGET:modern",
        "build:all": "npm run build:es5 && npm run build:modern",
        "watch": "rollup -c -w",
        "dev": "rollup -c --environment NODE_ENV:development",
        "es-check": "npx es-check es5 dist/bundle.es5.js"
    },
    "devDependencies": {
        "@babel/core": "^7.29.13",
        "@babel/preset-env": "^7.29.14",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-html": "^2.0.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.2",
        "autoprefixer": "^10.7.0",
        "cssnano": "^9.9.0",
        "postcss-import": "^17.0.1",
        "postcss-nested": "^9.0.1",
        "rollup": "^4.68.8",
        "rollup-plugin-license": "^3.7.2",
        "rollup-plugin-postcss": "^4.0.2"
    },
    "dependencies": {
        "core-js": "^3.51.0"
    }
}
