{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "types": [
      "@onlyoffice/doceditor-plugin-types",
      "@onlyoffice/doceditor-plugin-types/word"
    ]
  },
  "include": [
    "types/**/*.d.ts",
    "scripts/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "scripts/ui/components"
  ]
}
