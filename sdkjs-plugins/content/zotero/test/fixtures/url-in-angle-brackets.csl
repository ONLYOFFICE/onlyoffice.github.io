<?xml version="1.0" encoding="utf-8"?>
<!-- A numeric style that puts the URL in angle brackets, as the Slovak and
     Czech ISO-690 styles do: "Available at: <https://...>." -->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0">
  <info>
    <title>URL in angle brackets test</title>
    <id>http://www.zotero.org/styles/url-in-angle-brackets</id>
    <updated>2026-01-01T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name form="short"/>
    </names>
  </macro>
  <citation>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography>
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <text macro="author" suffix=". "/>
      <text variable="title" font-style="italic"/>
      <group prefix=". " delimiter=" ">
        <text value="Available at:"/>
        <text variable="URL" prefix="&lt;" suffix="&gt;"/>
      </group>
    </layout>
  </bibliography>
</style>
