          "description": "The width radius.",
          "name": "wR",
          "type": "GeometryCoordinate"
        },
        {
          "description": "The height radius.",
          "name": "hR",
          "type": "GeometryCoordinate"
        },
        {
          "description": "The start angle.",
          "name": "stAng",
          "type": "GeometryCoordinate"
        },
        {
          "description": "The sweep angle.",
          "name": "swAng",
          "type": "GeometryCoordinate"
        }
      ],
      "returns": {
        "type": "void"
      },
      "signature": "ArcTo(wR: GeometryCoordinate, hR: GeometryCoordinate, stAng: GeometryCoordinate, swAng: GeometryCoordinate): void",
      "since": "9.1.0"
    },
