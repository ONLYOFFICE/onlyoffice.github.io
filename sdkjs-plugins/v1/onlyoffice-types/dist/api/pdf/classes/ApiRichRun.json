      "params": [],
      "returns": {
        "type": "ApiRichRun"
      },
      "signature": "Copy(): ApiRichRun"
    },
    "GetClassType": {
      "description": "Returns a type of the ApiRichRun class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiRichRun/Methods/GetClassType/",
