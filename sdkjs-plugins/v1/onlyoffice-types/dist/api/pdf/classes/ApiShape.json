{
  "description": "Class representing a shape.",
  "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/",
  "extends": [
    "ApiDrawing"
  ],
  "methods": {
    "GetClassType": {
      "description": "Returns the type of the ApiShape class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "\"shape\""
      },
      "signature": "GetClassType(): \"shape\""
    },
    "GetContent": {
      "description": "Returns the shape inner contents where a paragraph or text runs can be inserted.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/Methods/GetContent/",
      "params": [],
      "returns": {
        "type": "ApiDocumentContent"
      },
      "signature": "GetContent(): ApiDocumentContent"
    },
    "GetDocContent": {
      "description": "Returns the shape inner contents where a paragraph or text runs can be inserted.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/Methods/GetDocContent/",
      "params": [],
      "returns": {
        "type": "ApiDocumentContent"
      },
      "signature": "GetDocContent(): ApiDocumentContent"
    },
    "GetFill": {
      "description": "Gets the fill properties from the current shape.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/Methods/GetFill/",
      "params": [],
      "returns": {
        "type": "ApiFill | null"
      },
      "signature": "GetFill(): ApiFill | null"
    },
    "GetGeometry": {
      "description": "Returns the geometry object from the current shape.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/Methods/GetGeometry/",
      "params": [],
      "returns": {
        "type": "ApiGeometry"
      },
      "signature": "GetGeometry(): ApiGeometry"
    },
    "GetLine": {
      "description": "Gets the outline properties from the current shape.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/Methods/GetLine/",
      "params": [],
      "returns": {
        "type": "ApiStroke | null"
      },
      "signature": "GetLine(): ApiStroke | null"
    },
    "GetParentPage": {
      "description": "Returns the type of the ApiDrawing class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiDrawing/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "ApiPage"
      },
      "signature": "GetParentPage(): ApiPage"
    },
    "GetPosX": {
      "description": "Gets the x position of the drawing on the page.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiDrawing/Methods/GetPosX/",
      "params": [],
      "returns": {
        "type": "EMU"
      },
      "signature": "GetPosX(): EMU"
    },
    "GetPosY": {
      "description": "Gets the y position of the drawing on the page.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiDrawing/Methods/GetPosY/",
      "params": [],
      "returns": {
        "type": "EMU"
      },
      "signature": "GetPosY(): EMU"
    },
    "GetTextFit": {
      "description": "Returns the text autofit type of the current shape.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/Methods/GetTextFit/",
      "params": [],
      "returns": {
        "description": "The text autofit type.",
        "type": "TextFitType"
      },
      "signature": "GetTextFit(): TextFitType",
      "since": "9.5.0"
    },
    "GetVerticalTextAlign": {
      "description": "Gets the vertical alignment from the shape content where a paragraph or text runs can be inserted.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/Methods/GetVerticalTextAlign/",
      "params": [],
      "returns": {
        "type": "VerticalTextAlign"
      },
      "signature": "GetVerticalTextAlign(): VerticalTextAlign"
    },
    "SetFill": {
      "description": "Sets the fill properties to the current shape.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/Methods/SetFill/",
      "params": [
        {
          "description": "The fill type used to fill the shape.",
          "name": "fill",
          "type": "ApiFill"
        }
      ],
      "returns": {
        "description": "returns false if param is invalid.",
        "type": "boolean"
      },
      "signature": "SetFill(fill: ApiFill): boolean"
    },
    "SetGeometry": {
      "description": "Sets a custom geometry for the current shape.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/Methods/SetGeometry/",
      "params": [
        {
          "description": "The geometry to set.",
          "name": "geometry",
          "type": "ApiGeometry"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetGeometry(geometry: ApiGeometry): boolean"
    },
    "SetLine": {
      "description": "Sets the outline properties to the current shape.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/Methods/SetLine/",
      "params": [
        {
          "description": "The stroke used to create the shape outline.",
          "name": "stroke",
          "type": "ApiStroke"
        }
      ],
      "returns": {
        "description": "returns false if param is invalid.",
        "type": "boolean"
      },
      "signature": "SetLine(stroke: ApiStroke): boolean"
    },
    "SetPaddings": {
      "description": "Sets the text paddings to the current shape.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/Methods/SetPaddings/",
      "params": [
        {
          "description": "Left padding.",
          "name": "nLeft",
          "type": "EMU"
        },
        {
          "description": "Top padding.",
          "name": "nTop",
          "type": "EMU"
        },
        {
          "description": "Right padding.",
          "name": "nRight",
          "type": "EMU"
        },
        {
          "description": "Bottom padding.",
          "name": "nBottom",
          "type": "EMU"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetPaddings(nLeft: EMU, nTop: EMU, nRight: EMU, nBottom: EMU): boolean",
      "since": "9.5.0"
    },
    "SetPosX": {
      "description": "Sets the x position of the drawing on the page.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiDrawing/Methods/SetPosX/",
      "params": [
        {
          "description": "The distance from the left side of the page to the left side of the drawing measured in English measure units.",
          "name": "posX",
          "type": "EMU"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetPosX(posX: EMU): boolean"
    },
    "SetPosY": {
      "description": "Sets the y position of the drawing on the page.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiDrawing/Methods/SetPosY/",
      "params": [
        {
          "description": "The distance from the top side of the page to the upper side of the drawing measured in English measure units.",
          "name": "posY",
          "type": "EMU"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetPosY(posY: EMU): boolean"
    },
    "SetPosition": {
      "description": "Sets the position of the drawing on the page.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiDrawing/Methods/SetPosition/",
      "params": [
        {
          "description": "The distance from the left side of the page to the left side of the drawing measured in English measure units.",
          "name": "posX",
          "type": "EMU"
        },
        {
          "description": "The distance from the top side of the page to the upper side of the drawing measured in English measure units.",
          "name": "posY",
          "type": "EMU"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetPosition(posX: EMU, posY: EMU): boolean"
    },
    "SetTextFit": {
      "description": "Sets the text autofit type to the current shape.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/Methods/SetTextFit/",
      "params": [
        {
          "description": "The text autofit type.",
          "name": "fitType",
          "type": "TextFitType"
        }
      ],
      "returns": {
        "description": "returns false if the type is invalid or the shape doesn't exist.",
        "type": "boolean"
      },
      "signature": "SetTextFit(fitType: TextFitType): boolean",
      "since": "9.5.0"
    },
    "SetVerticalTextAlign": {
      "description": "Sets the vertical alignment to the shape content where a paragraph or text runs can be inserted.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiShape/Methods/SetVerticalTextAlign/",
      "params": [
        {
          "description": "The type of the vertical alignment for the shape inner contents.",
          "name": "verticalAlign",
          "type": "VerticalTextAlign"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetVerticalTextAlign(verticalAlign: VerticalTextAlign): boolean"
    }
  }
}
