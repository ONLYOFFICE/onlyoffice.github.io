      "description": "Sets time format for field.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTextField/Methods/SetTimeFormat/",
      "params": [
        {
          "description": "available time format",
          "name": "format",
          "type": "TimeFormat"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetTimeFormat(format: TimeFormat): boolean"
    },
