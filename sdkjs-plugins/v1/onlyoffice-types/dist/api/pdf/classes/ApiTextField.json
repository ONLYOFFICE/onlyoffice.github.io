      "description": "Sets regular expression validate string for field.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTextField/Methods/SetRegularExp/",
      "params": [
        {
          "description": "The validation regular expression (e.g. \"\\\\S+@\\\\S+\\\\.\\\\S+\")",
          "name": "regularExpression",
          "type": "string"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetRegularExp(regularExpression: string): boolean"
    },
    "SetRequired": {
      "description": "Sets field required",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/SetRequired/",
      "params": [
        {
          "description": "Specifies whether the field is required.",
          "name": "required",
          "type": "boolean"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetRequired(required: boolean): boolean"
