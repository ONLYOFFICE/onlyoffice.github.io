        {
          "description": "Specifies whether the field is read-only.",
          "name": "readOnly",
          "type": "boolean"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetReadOnly(readOnly: boolean): boolean"
    },
