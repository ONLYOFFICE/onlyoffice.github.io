      "description": "Sets special format for field.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTextField/Methods/SetSpecialFormat/",
      "params": [
        {
          "description": "the formatting style to apply to the value",
          "name": "format",
          "type": "PsfFormat"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetSpecialFormat(format: PsfFormat): boolean"
    },
