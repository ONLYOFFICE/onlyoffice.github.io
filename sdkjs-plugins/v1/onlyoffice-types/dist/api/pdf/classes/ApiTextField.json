      "returns": {
        "type": "boolean"
      },
      "signature": "IsMultiline(): boolean"
    },
    "IsReadOnly": {
      "description": "Checks if field is read only",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/IsReadOnly/",
      "params": [],
      "returns": {
        "type": "boolean"
      },
      "signature": "IsReadOnly(): boolean"
    },
    "IsRequired": {
      "description": "Checks if field is required",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/IsRequired/",
      "params": [],
      "returns": {
        "type": "boolean"
      },
      "signature": "IsRequired(): boolean"
    },
