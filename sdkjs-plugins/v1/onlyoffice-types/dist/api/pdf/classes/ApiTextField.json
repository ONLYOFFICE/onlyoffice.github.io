      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/Delete/",
      "params": [],
      "returns": {
        "type": "boolean"
      },
      "signature": "Delete(): boolean"
    },
    "GetAllWidgets": {
      "description": "Gets array with widgets of the current field.",
