      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTextField/Methods/SetComb/",
      "params": [
        {
          "description": "Specifies whether comb formatting is enabled.",
          "name": "comb",
          "type": "boolean"
        }
      ],
      "returns": {
        "type": "boolean"
      },
