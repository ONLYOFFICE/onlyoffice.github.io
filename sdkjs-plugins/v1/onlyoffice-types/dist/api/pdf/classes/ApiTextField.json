      "description": "Sets whether the text field can scroll long text.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTextField/Methods/SetScrollLongText/",
      "params": [
        {
          "description": "Specifies whether long text can be scrolled.",
          "name": "allowScroll",
          "type": "boolean"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetScrollLongText(allowScroll: boolean): boolean"
    },
