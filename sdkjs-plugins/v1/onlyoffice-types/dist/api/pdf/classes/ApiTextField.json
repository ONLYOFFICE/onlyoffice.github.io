      "description": "Gets the text field character limit.\n<note> Char limit 0 means field doesn't have char limit",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTextField/Methods/GetCharLimit/",
      "params": [],
      "returns": {
        "type": "number"
      },
      "signature": "GetCharLimit(): number"
    },
    "GetClassType": {
      "description": "Returns a type of the ApiTextField class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTextField/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "\"textField\""
      },
      "signature": "GetClassType(): \"textField\""
    },
    "GetFormattedValue": {
      "description": "Gets formatted value of a field.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTextField/Methods/GetFormattedValue/",
