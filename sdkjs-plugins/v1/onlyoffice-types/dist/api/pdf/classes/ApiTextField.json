      "description": "Sets validate range for field.\n<note> Can only be applied to fields with a percentage or number format. </note>",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiTextField/Methods/SetValidateRange/",
      "params": [
        {
          "description": "If true, enables minimum value validation using `greaterThanValue`.",
          "name": "greaterThan",
          "optional": true,
          "type": "boolean"
        },
        {
          "description": "The minimum allowed value.",
          "name": "greaterThanValue",
          "optional": true,
          "type": "number"
        },
        {
          "description": "If true, enables maximum value validation using `lessThanValue`.",
          "name": "lessThan",
          "optional": true,
          "type": "boolean"
        },
        {
          "description": "The maximum allowed value.",
          "name": "lessThanValue",
          "optional": true,
          "type": "number"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetValidateRange(greaterThan?: boolean, greaterThanValue?: number, lessThan?: boolean, lessThanValue?: number): boolean"
    },
    "SetValue": {
      "description": "Sets field value",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiBaseField/Methods/SetValue/",
      "params": [
        {
          "description": "The new value for the field.",
          "name": "value",
          "type": "string"
        }
      ],
      "returns": {
        "type": "boolean"
      },
      "signature": "SetValue(value: string): boolean"
    }
