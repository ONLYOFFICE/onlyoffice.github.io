{
  "description": "Class representing a underline annotation.",
  "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/pdf-api/ApiUnderlineAnnotation/",
  "extends": [
    "ApiBaseMarkupAnnotation"
  ],
  "methods": {
