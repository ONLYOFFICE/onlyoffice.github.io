{
  "description": "Class representing a notes page.",
  "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiNotesPage/",
  "methods": {
    "AddBodyShapeText": {
      "description": "Adds a text to the body shape of the current notes page.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiNotesPage/Methods/AddBodyShapeText/",
      "params": [
        {
          "description": "The text to be added to the body shape.",
          "name": "sText",
          "type": "string"
        }
      ],
      "returns": {
        "description": "Returns true if text was added successfully, otherwise false.",
        "type": "boolean"
      },
      "signature": "AddBodyShapeText(sText: string): boolean",
      "since": "9.0.0"
    },
    "GetBodyShape": {
      "description": "Returns a shape with the type=\"body\" attribute from the current notes page.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiNotesPage/Methods/GetBodyShape/",
      "params": [],
      "returns": {
        "type": "ApiShape | null"
      },
      "signature": "GetBodyShape(): ApiShape | null",
      "since": "9.0.0"
    },
    "GetBodyShapeText": {
      "description": "Returns the text from the body shape of the current notes page.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiNotesPage/Methods/GetBodyShapeText/",
      "params": [],
      "returns": {
        "description": "The text from the body shape.",
        "type": "string"
      },
      "signature": "GetBodyShapeText(): string",
      "since": "9.1.0"
    },
    "GetClassType": {
      "description": "Returns the type of the ApiNotesPage class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiNotesPage/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "\"notesPage\""
      },
      "signature": "GetClassType(): \"notesPage\"",
      "since": "9.0.0"
    },
    "GetTheme": {
      "description": "Returns a theme of the current notes page.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/presentation-api/ApiNotesPage/Methods/GetTheme/",
      "params": [],
      "returns": {
        "description": "Returns null if the notes page master or theme doesn't exist.",
        "type": "ApiTheme | null"
      },
      "signature": "GetTheme(): ApiTheme | null",
      "since": "9.3.0"
    }
  }
}
