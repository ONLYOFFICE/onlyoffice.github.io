{
  "description": "Represents a color that can be applied to text.",
  "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiColor/",
  "methods": {
    "FromJSON": {
      "description": "Converts the JSON object into the ApiColor object.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiColor/Methods/FromJSON/",
      "params": [
        {
          "description": "JSON representation of the color.",
          "name": "jsonObject",
          "type": "string"
        }
      ],
      "returns": {
        "description": "new ApiColor object if the conversion was successful, null otherwise.",
        "type": "ApiColor | null"
      },
      "signature": "FromJSON(jsonObject: string): ApiColor | null",
      "since": "9.3.0"
    },
    "GetClassType": {
      "description": "Returns a type of the ApiColor class.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiColor/Methods/GetClassType/",
      "params": [],
      "returns": {
        "type": "\"color\""
      },
      "signature": "GetClassType(): \"color\"",
      "since": "9.1.0"
    },
    "GetHex": {
      "description": "Gets the HEX string representation of the color.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiColor/Methods/GetHex/",
      "params": [],
      "returns": {
        "description": "A six-digit uppercase hex string, e.g. \"FF00AA\".",
        "type": "string"
      },
      "signature": "GetHex(): string",
      "since": "9.1.0"
    },
    "GetRGB": {
      "description": "Gets the RGB components of the color.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiColor/Methods/GetRGB/",
      "params": [],
      "returns": {
        "type": "object"
      },
      "signature": "GetRGB(): object",
      "since": "9.1.0"
    },
    "GetRGBA": {
      "description": "Gets the RGBA components of the color.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiColor/Methods/GetRGBA/",
      "params": [],
      "returns": {
        "type": "object"
      },
      "signature": "GetRGBA(): object",
      "since": "9.1.0"
    },
    "GetThemeName": {
      "description": "Gets the theme color name if the color is a theme color.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiColor/Methods/GetThemeName/",
      "params": [],
      "returns": {
        "description": "The theme color name or null if not a theme color.",
        "type": "SchemeColorId | null"
      },
      "signature": "GetThemeName(): SchemeColorId | null",
      "since": "9.3.0"
    },
    "IsAutoColor": {
      "description": "Returns true if the color is set to auto.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiColor/Methods/IsAutoColor/",
      "params": [],
      "returns": {
        "type": "boolean"
      },
      "signature": "IsAutoColor(): boolean",
      "since": "9.1.0"
    },
    "IsThemeColor": {
      "description": "Returns true if the color is a theme color.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiColor/Methods/IsThemeColor/",
      "params": [],
      "returns": {
        "type": "boolean"
      },
      "signature": "IsThemeColor(): boolean",
      "since": "9.1.0"
    },
    "ToJSON": {
      "description": "Converts the ApiColor object into the JSON object.",
      "docsUrl": "https://api.onlyoffice.com/docs/office-api/usage-api/document-api/ApiColor/Methods/ToJSON/",
      "params": [],
      "returns": {
        "description": "JSON string representation of the color.",
        "type": "string"
      },
      "signature": "ToJSON(): string",
      "since": "9.3.0"
    }
  }
}
