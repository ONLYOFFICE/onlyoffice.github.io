{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@onlyoffice/plugins-types",
  "version": "0.9.0",
  "description": "TypeScript type definitions for the ONLYOFFICE Plugin API",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./word": {
      "types": "./src/editors/word.d.ts"
    },
    "./cell": {
      "types": "./src/editors/cell.d.ts"
    },
    "./slide": {
      "types": "./src/editors/slide.d.ts"
    },
    "./pdf": {
      "types": "./src/editors/pdf.d.ts"
    },
    "./plugin": {
      "types": "./src/plugin/index.d.ts"
    },
    "./plugin/*": {
      "types": "./src/plugin/*.d.ts"
    },
    "./config": {
      "types": "./src/config/index.d.ts"
    },
    "./services": {
      "types": "./src/services/index.d.ts"
    },
    "./config/schema.json": "./schemas/config.schema.json",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "word": [
        "src/editors/word.d.ts"
      ],
      "cell": [
        "src/editors/cell.d.ts"
      ],
      "slide": [
        "src/editors/slide.d.ts"
      ],
      "pdf": [
        "src/editors/pdf.d.ts"
      ],
      "plugin": [
        "src/plugin/index.d.ts"
      ],
      "plugin/*": [
        "src/plugin/*"
      ],
      "config": [
        "src/config/index.d.ts"
      ],
      "services": [
        "src/services/index.d.ts"
      ]
    }
  },
  "files": [
    "index.d.ts",
    "src",
    "schemas",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ONLYOFFICE/onlyoffice.github.io.git",
    "directory": "sdkjs-plugins/v1/onlyoffice-types"
  },
  "homepage": "https://github.com/ONLYOFFICE/onlyoffice.github.io/tree/master/sdkjs-plugins/v1/onlyoffice-types#readme",
  "bugs": {
    "url": "https://github.com/ONLYOFFICE/onlyoffice.github.io/issues?q=is%3Aissue%20onlyoffice-types"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Ascensio System SIA",
    "email": "integration@onlyoffice.com",
    "url": "https://www.onlyoffice.com"
  },
  "keywords": [
    "onlyoffice",
    "plugin",
    "plugins-api",
    "typescript",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate-types.js",
    "postgenerate": "node scripts/generate-plugin-methods.js && node scripts/generate-ambient-bundle.js",
    "generate-plugin-methods": "node scripts/generate-plugin-methods.js",
    "generate-schema": "node scripts/generate-config-schema.js",
    "generate-ambient": "node scripts/generate-ambient-bundle.js",
    "check-generated": "npm run generate -- --require-clean-sources && git diff --exit-code -- src/generated",
    "check-runtime": "node scripts/check-runtime-contract.js",
    "check-plugin-events": "node scripts/check-plugin-events.js",
    "validate-schema": "node scripts/validate-config-schema.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "peerDependencies": {
    "typescript": ">=4.0.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "jsdoc": "^4.0.5",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.9.3"
  }
}
