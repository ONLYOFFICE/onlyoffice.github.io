{
  // One TypeScript program per editor, because each editor entry point declares the SAME global
  // `Api` with a different type - putting two in one program is an immediate TS2403 collision.
  // That is exactly the situation a shared `declare var Api: any` stub used to paper over, at the
  // cost of every `Api.*` call in these copied documentation examples going unchecked.
  //
  // `files` (not `include`) carries the entry point: the base config excludes `src/editors`, and
  // `exclude` filters `include` but never `files`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowJs": true,
    "checkJs": true,
    "strict": false
  },
  "files": ["src/editors/pdf.d.ts"],
  "include": [
    "index.d.ts",
    "src/generated/*.ts",
    "src/overrides/*.ts",
    "src/plugin/**/*.d.ts",
    "src/config/**/*.d.ts",
    "src/services/**/*.d.ts",
    "src/theme/**/*.d.ts",
    "test/pdf-methods-smoke.js",
    "test/pdf-api-global.js"
  ]
}
