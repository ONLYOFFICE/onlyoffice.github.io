{
  // The editor-agnostic program: the package itself, plus the tests that do not need a typed global
  // `Api`. Each editor's documentation examples live in their own `tsconfig.test.<editor>.json`,
  // because the four entry points all declare the same global `Api` with a different type and
  // cannot share one program.
  //
  // `example.js` stays here deliberately: it demonstrates several editors in one file and annotates
  // its own `Api` as `any`, which is honest for a multi-editor sampler and would collide with a real
  // entry point.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowJs": true,
    "checkJs": true,
    "strict": false
  },
  "include": [
    "index.d.ts",
    "src/generated/*.ts",
    "src/overrides/*.ts",
    "src/**/*.d.ts",
    "example.js",
    "test/plugin-runtime-typing.js"
  ]
}
